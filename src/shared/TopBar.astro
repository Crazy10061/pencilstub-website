---
import curseforgeIcon from '../assets/curseforge.svg';
import discordIcon from '../assets/discord.svg';
import githubIcon from '../assets/github.svg';
import mailIcon from '../assets/mail.svg';
import modrinthIcon from '../assets/modrinth.svg';

export interface SocialLink {
	/** Accessible name (alt text / screen-reader label). */
	label: string;
	href: string;
	/** An image URL (rendered with <img>), or... */
	src?: string;
	/** ...an inline SVG (rendered with fill="currentColor", so it follows the link color). */
	svg?: { viewBox: string; path: string };
}

export interface Props {
	/** Social/profile links. Defaults to the main site's links. */
	links?: SocialLink[];
	/** Text of the brand link (left side). */
	title?: string;
	/**
	 * default: static bar.
	 * overlay: fixed and transparent, turns solid (and reveals `title`) after scrolling;
	 *          the links are hidden on narrow screens.
	 */
	variant?: 'default' | 'overlay';
}

/*
 * Per-site theming (overlay variant): set these CSS custom properties on an
 * ancestor (e.g. :root in the site's global stylesheet).
 *
 *   --topbar-link-color   --topbar-scrolled-bg   --topbar-scrolled-shadow
 */

const defaultLinks: SocialLink[] = [
	{ src: modrinthIcon.src, label: 'Modrinth', href: 'https://modrinth.com/user/tomatopotato' },
	{
		src: curseforgeIcon.src,
		label: 'CurseForge',
		href: 'https://www.curseforge.com/members/tomatopotato/',
	},
	{ src: githubIcon.src, label: 'GitHub', href: 'https://github.com/tomatopotato17265' },
	{ src: discordIcon.src, label: 'Discord', href: 'https://discord.com/users/821825130506092594' },
	{ src: mailIcon.src, label: 'Mail', href: 'mailto:contact@pencilstub.dev' },
];

const { links = defaultLinks, title = '', variant = 'default' } = Astro.props;
---

{
	variant === 'overlay' ? (
		<header class="top-bar-overlay" data-topbar-overlay>
			<nav>
				<h2>
					<a href="/">{title}</a>
				</h2>
				<div class="social-links">
					{links.map((link) => (
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							<span class="sr-only">{link.label}</span>
							{link.svg ? (
								<svg viewBox={link.svg.viewBox} aria-hidden="true" width="20" height="20">
									<path fill="currentColor" d={link.svg.path} />
								</svg>
							) : (
								<img src={link.src} alt="" width="20" height="20" />
							)}
						</a>
					))}
				</div>
			</nav>
		</header>
	) : (
		<header class="top-bar">
			<a class="brand" href="/">
				{title}
			</a>
			<div class="icons">
				{links.map((link) => (
					<a href={link.href} target="_blank" rel="noopener noreferrer">
						{link.svg ? (
							<svg
								viewBox={link.svg.viewBox}
								role="img"
								aria-label={link.label}
								width="30"
								height="30"
							>
								<path fill="currentColor" d={link.svg.path} />
							</svg>
						) : (
							<img src={link.src} alt={link.label} width="40" height="40" />
						)}
					</a>
				))}
			</div>
		</header>
	)
}

<script>
	const header = document.querySelector<HTMLElement>('[data-topbar-overlay]');
	if (header) {
		const REVEAL_AFTER = 200;
		let ticking = false;
		const sync = () => {
			const scrollY = window.scrollY || document.documentElement.scrollTop || 0;
			header.classList.toggle('scrolled', scrollY > REVEAL_AFTER);
			ticking = false;
		};
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(sync);
		};
		sync();
		window.addEventListener('scroll', onScroll, { passive: true });
	}
</script>

<style>
	/* ---------- default variant ---------- */
	.top-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.5rem;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		background: #fff;
		border-bottom: 1px solid rgba(17, 24, 39, 0.1);
	}

	.brand {
		font-weight: 700;
		color: #111827;
		text-decoration: none;
	}

	.icons {
		display: flex;
		align-items: center;
		gap: 1.1rem;
	}

	.icons a {
		display: block;
		line-height: 0;
	}

	.icons img {
		display: block;
		width: 30px;
		height: 30px;
		filter: brightness(0) saturate(100%);
		opacity: 0.85;
		transition: opacity 0.2s;
	}

	.icons img:hover {
		opacity: 1;
	}

	/* ---------- overlay variant ---------- */
	.top-bar-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1em;
		background-color: transparent;
		box-shadow: none;
		transition:
			background-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.top-bar-overlay.scrolled {
		background-color: var(--topbar-scrolled-bg, #0a0a0a);
		box-shadow: var(--topbar-scrolled-shadow, 0 2px 8px rgba(0, 0, 0, 0.3));
	}

	.top-bar-overlay h2 {
		margin: 0;
		font-size: 1em;
	}

	.top-bar-overlay h2 a {
		text-decoration: none;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.top-bar-overlay.scrolled h2 a {
		opacity: 1;
		pointer-events: auto;
	}

	.top-bar-overlay nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.top-bar-overlay nav a {
		padding: 1em 0.5em;
		color: var(--topbar-link-color, #fff);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	.top-bar-overlay .social-links,
	.top-bar-overlay .social-links a {
		display: flex;
	}

	.sr-only {
		border: 0;
		padding: 0;
		margin: 0;
		position: absolute !important;
		height: 1px;
		width: 1px;
		overflow: hidden;
		clip: rect(1px, 1px, 1px, 1px);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		.top-bar-overlay .social-links {
			display: none;
		}
	}
</style>
